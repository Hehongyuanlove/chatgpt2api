# Server mode
OA_LISTEN=:8080
OA_SESSION_DIR=.
OA_API_KEY=
OA_MAX_CONCURRENT=1
OA_SESSION_STRATEGY=round-robin
OA_PROMPT_DIR=prompts

# Proxy (also used in CLI mode)
OA_PROXY=

# CLI mode
OA_SESSION=
OA_FORCE_REFRESH=false

# Conv state
OA_CLEAN_STALE_CONV=false

# Tool caching (hash-based, skips tool injection when unchanged)
OA_CACHE_TOOLS=true
